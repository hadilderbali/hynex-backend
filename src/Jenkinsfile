pipeline {
    agent any

    environment {
        REGISTRY_PUSH = 'localhost:5000'
        REGISTRY_PULL = '10.0.2.15:5000'
        IMAGE_NAME = 'hynex-backend'
        KUBECONFIG = '/var/jenkins_home/.kube/config'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checked out successfully.'
            }
        }

        stage('Build') {
            steps {
                sh 'chmod +x mvnw'
                withCredentials([
                    string(
                        credentialsId: 'groq-api-key',
                        variable: 'GROQ_API_KEY'
                    )
                ]) {
                    sh './mvnw -B -DskipTests compile'
                }
            }
        }

        stage('Test') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'groq-api-key',
                        variable: 'GROQ_API_KEY'
                    ),
                    string(
                        credentialsId: 'db-username',
                        variable: 'SPRING_DATASOURCE_USERNAME'
                    ),
                    string(
                        credentialsId: 'db-password',
                        variable: 'SPRING_DATASOURCE_PASSWORD'
                    )
                ]) {
                    sh './mvnw -B test'
                }
            }
        }

      stage('OWASP Dependency-Check') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'nvd-api-key',
                        variable: 'NVD_API_KEY'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "Starting OWASP Dependency-Check..."

                        ./mvnw -B \
                            org.owasp:dependency-check-maven:13.0.0:check \
                            -DnvdApiKeyEnvironmentVariable=NVD_API_KEY \
                            -Dformats=HTML,JSON \
                            -DfailBuildOnCVSS=11
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts(
                        artifacts: 'target/dependency-check-report.html,target/dependency-check-report.json',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        /*
        // FUTURE: Enable after configuring SonarQube in Jenkins.
        // SonarQube server named "SonarQube".

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        ./mvnw -B \
                            org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.projectKey=hynex-backend
                    '''
                }
            }
        }
        */

        stage('Package') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'groq-api-key',
                        variable: 'GROQ_API_KEY'
                    )
                ]) {
                    sh './mvnw -B -DskipTests package'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t ${REGISTRY_PUSH}/${IMAGE_NAME}:${BUILD_NUMBER} .'
            }
        }

        
        stage('Trivy Security Scan') {
            steps {
                sh '''
                    set -eu
                    echo "Starting Trivy security scan..."

                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v trivy-cache:/root/.cache/ \
                        aquasec/trivy:0.76.0 \
                        image \
                        --timeout 20m \
                        --no-progress \
                        --docker-host unix:///var/run/docker.sock \
                        --image-src docker \
                        --scanners vuln,secret \
                        --image-config-scanners secret \
                        --severity HIGH,CRITICAL \
                        --format table \
                        --exit-code 0 \
                        "${REGISTRY_PUSH}/${IMAGE_NAME}:${BUILD_NUMBER}"
                '''
            }
        }
        

        stage('Docker Push') {
            steps {
                sh 'docker push ${REGISTRY_PUSH}/${IMAGE_NAME}:${BUILD_NUMBER}'
            }
        }

        stage('Kubernetes Access Check') {
            steps {
                sh '''
                    set -eu
                    kubectl version --client
                    kubectl get deployments,services,pods
                '''
            }
        }

        stage('Kubernetes Deploy') {
            steps {
                sh '''
                    set -eu

                    kubectl apply -f k8s/configmap.yaml
                    kubectl apply -f k8s/service.yaml

                    sed "s|image: hynex-backend:placeholder|image: ${REGISTRY_PULL}/${IMAGE_NAME}:${BUILD_NUMBER}|" \
                        k8s/deployment.yaml \
                        > "${WORKSPACE}/deployment-${BUILD_NUMBER}.yaml"

                    grep -F "image: ${REGISTRY_PULL}/${IMAGE_NAME}:${BUILD_NUMBER}" \
                        "${WORKSPACE}/deployment-${BUILD_NUMBER}.yaml"
                '''

                withCredentials([
                    string(
                        credentialsId: 'groq-api-key',
                        variable: 'GROQ_API_KEY'
                    ),
                    string(
                        credentialsId: 'db-username',
                        variable: 'SPRING_DATASOURCE_USERNAME'
                    ),
                    string(
                        credentialsId: 'db-password',
                        variable: 'SPRING_DATASOURCE_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x
                        kubectl create secret generic hynex-runtime-secrets \
                            --from-literal=groq-api-key="$GROQ_API_KEY" \
                            --from-literal=db-username="$SPRING_DATASOURCE_USERNAME" \
                            --from-literal=db-password="$SPRING_DATASOURCE_PASSWORD" \
                            --dry-run=client -o yaml \
                        | kubectl apply -f -
                    '''
                }

                sh '''
                    set -eu
                    kubectl apply -f "${WORKSPACE}/deployment-${BUILD_NUMBER}.yaml"
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    set -eu

                    kubectl rollout status deployment/hynex-backend \
                        --timeout=240s

                    kubectl get deployment hynex-backend
                    kubectl get pods -l app=hynex-backend -o wide
                    kubectl get service hynex-backend
                '''
            }
        }
    
        stage('Smoke Test') {
            steps {
                sh '''
                    set -eu

                    APP_URL="http://10.0.2.15:30087"

                    echo "Checking HYNEX health..."
                    curl --retry 5 \
                         --retry-delay 3 \
                         --retry-connrefused \
                         --fail --silent --show-error \
                         "$APP_URL/actuator/health"

                    echo
                    echo "Checking Prometheus metrics..."
                    curl --fail --silent --show-error \
                         "$APP_URL/actuator/prometheus" \
                         | grep -q '^# HELP '

                    echo "Smoke tests passed."
                '''
            }
        }
    }

    post {
        success {
            echo 'HYNEX CI/CD pipeline and Kubernetes deployment completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Inspect the failed stage and Kubernetes diagnostics.'

            sh '''
                kubectl get pods -l app=hynex-backend -o wide || true
                kubectl describe deployment/hynex-backend || true
                kubectl logs -l app=hynex-backend --all-containers=true --tail=80 || true
            '''
        }
    }
}
