
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checked out successfully.'
            }
        }

        stage('Build') {
            steps {
                sh 'chmod +x mvnw'
                withCredentials([string(
                    credentialsId: 'groq-api-key',
                    variable: 'GROQ_API_KEY'
                )]) {
                    sh './mvnw -B -DskipTests compile'
                }
            }
        }

        stage('Test') {
            steps {
                withCredentials([string(
                    credentialsId: 'groq-api-key',
                    variable: 'GROQ_API_KEY'
                )]) {
                    sh './mvnw -B test'
                }
            }
        }


        stage('Package') {
            steps {
                withCredentials([string(
                    credentialsId: 'groq-api-key',
                    variable: 'GROQ_API_KEY'
                )]) {
                    sh './mvnw -B -DskipTests package'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t hynex-backend:${BUILD_NUMBER} .'
            }
        }
    }

    post {
        success {
            echo 'HYNEX backend pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
    }
}

